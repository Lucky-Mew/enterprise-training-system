.search-box {
  margin-bottom: 30rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}

/* 表格容器 */
.table-container {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
  margin-bottom: 30rpx;
}

/* 表格样式 */
.custom-table {
  .header-row {
    background: #f8fafc !important;
    th {
      font-weight: 500;
      color: #606266;
      font-size: 28rpx;
      padding: 28rpx 0;
    }
  }
  
  .data-row {
    td {
      color: #303133;
      font-size: 26rpx;
      padding: 24rpx 0;
      border-bottom: 1rpx solid #f0f2f5;
    }
    
    &:last-child td {
      border-bottom: none;
    }
  }
  
  .title-cell {
    @include text-ellipsis(2);
    line-height: 1.4;
  }
}

/* 状态标签 */
.status-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  
  &.status-0 {
    background: #fee2e2;
    color: #dc2626;
  }
  &.status-1 {
    background: #dbeafe;
    color: #2563eb;
  }
  &.status-2 {
    background: #dcfce7;
    color: #16a34a;
  }
}

/* 分页样式 */
.pagination-wrapper {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}

/* 弹窗内容 */
.modal-content {
  padding: 20rpx 0;
  
  .info-card {
    background: #fff;
    border-radius: 12rpx;
    padding: 24rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
    
    .info-item {
      display: flex;
      align-items: center;
      margin-bottom: 24rpx;
      &:last-child {
        margin-bottom: 0;
      }
      
      .info-label {
        width: 160rpx;
        color: #909399;
        font-size: 28rpx;
        font-weight: 500;
      }
      
      .info-value {
        flex: 1;
        color: #303133;
        font-size: 28rpx;
        line-height: 1.4;
      }
    }
  }
  
  .upload-section {
    padding: 24rpx;
    background: #fff;
    border-radius: 12rpx;
    margin-bottom: 30rpx;
    
    .section-title {
      display: block;
      color: #303133;
      font-size: 30rpx;
      font-weight: 500;
      margin-bottom: 20rpx;
    }
  }
  
  .submit-section {
    text-align: center;
    margin-top: 40rpx;
  }
}

/* 按钮优化 */
.u-btn--primary {
  transition: all 0.3s;
  &:active {
    transform: scale(0.98);
  }
  
  &[disabled] {
    opacity: 0.6;
    filter: grayscale(0.5);
  }
}
</style>