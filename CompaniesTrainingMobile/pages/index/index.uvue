<template>
  <view class="personal-center">
    <!-- 个人信息部分 -->
    <view class="user-info">
      <image class="avatar" :src="user.avatar" mode="aspectFill" />
      <view class="info">
        <text class="name">{{ user.username }}</text>
        <text class="account">{{ user.name }}</text>
      </view>
    </view>

    <!-- 功能项部分 -->
    <view class="menu">
      <view class="menu-item" @click="logout">退出登录</view>
    </view>
  </view>
</template>

<script>
export default {
  data() {
    return {
      user: {},
    };
  },
  onShow() {
    this.getUser();
  },
  methods: {
    getUser() {
      this.user = JSON.parse(uni.getStorageSync('user') || '{}');
    },
    logout() {
      uni.showModal({
        title: '提示',
        content: '确定要退出登录吗？',
        success: (res) => {
          if (res.confirm) {
            // 清空本地缓存
            uni.removeStorageSync('user');
            // 清空当前用户数据
            this.user = {};
            // 跳转到登录页
            uni.reLaunch({
              url: '/pages/login/login' // 根据实际登录页面路径修改
            });
          }
        }
      });
    }
  },
};
</script>

<style scoped>
.personal-center {
  padding: 20px;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.user-info {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 10px;
  padding: 20px;
  margin-bottom: 20px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

.avatar {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  border: 2px solid #ff6a00;
  margin-right: 20px;
}

.info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name {
  font-size: 22px;
  font-weight: bold;
  color: #333;
}

.account {
  font-size: 14px;
  color: #888;
}

.menu {
  background-color: #fff;
  border-radius: 10px;
  padding: 15px;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

.menu-item {
  padding: 12px;
  font-size: 16px;
  background-color: #f5f5f5;
  margin-bottom: 10px;
  border-radius: 8px;
  text-align: center;
  color: #333;
  transition: background-color 0.3s, color 0.3s;
}

.menu-item:hover {
  background-color: #ff6a00;
  color: #fff;
}

.menu-item:last-child {
  margin-bottom: 0;
}
</style>