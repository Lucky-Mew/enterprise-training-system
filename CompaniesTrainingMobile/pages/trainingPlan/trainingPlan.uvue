	/* 容器增加内边距 */
	.container {
		padding: 20rpx 28rpx;
		background: #f8f9fa;
		min-height: 100vh;
	}

	/* 搜索框样式优化 */
	.u-search {
		border-radius: 16rpx !important;
		overflow: hidden;
		box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
	}
	
	/* 搜索按钮样式 */
	:deep(.u-search__action) {
		background: #2979ff !important;
		color: #fff !important;
		border-radius: 12rpx;
		padding: 0 28rpx !important;
		margin-left: 20rpx;
	}

	/* 培训项改为卡片式设计 */
	.Training-item {
		background: #fff;
		border-radius: 16rpx;
		padding: 28rpx;
		margin-bottom: 24rpx;
		box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
		transition: all 0.3s;
	}

	/* 悬停效果 */
	.Training-item:active {
		transform: translateY(2rpx);
		box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
	}

	/* 标题样式 */
	.title {
		font-size: 32rpx;
		font-weight: 600;
		color: #303133;
		margin-bottom: 16rpx;
		display: block;
	}

	/* 副标题样式 */
	.synopsis {
		font-size: 26rpx;
		color: #606266;
		line-height: 1.6;
		margin-bottom: 12rpx;
		display: block;
	}

	/* 时间容器布局 */
	.uni-row {
		display: flex;
		justify-content: space-between;
		margin-top: 16rpx;
	}

	/* 时间文字样式 */
	.startTime, .endTime {
		font-size: 24rpx;
		color: #909399;
		flex: 1;
	}

	/* 加载状态文字颜色 */
	.u-loadmore {
		color: #909399 !important;
		padding: 32rpx 0;
	}

	/* 空状态图片调整 */
	.u-empty {
		padding-top: 100rpx;
	}
	.u-empty__image {
		width: 280rpx !important;
		height: 280rpx !important;
	}
</style>

