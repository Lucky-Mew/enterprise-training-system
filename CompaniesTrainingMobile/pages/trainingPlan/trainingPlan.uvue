<template>
	<view class="container">
		<!-- 搜索框 -->
		<u-search style="margin-top: 10rpx;" v-model="title" placeholder="输入培训标题搜索" :show-action="true" action-text="搜索"
			@search="handleSearch" @custom="handleSearch"></u-search>

		<!-- 空数据提示 -->
		<u-empty v-if="list.length === 0 && !loading" mode="data" icon="http://cdn.uviewui.com/uview/empty/data.png"
			text="没有找到相关培训计划" />

		<!-- 数据列表 -->
		<scroll-view v-else scroll-y style="height: calc(100vh - 100rpx);" @scrolltolower="loadMore">
			<u-list>
				<u-list-item v-for="(item, index) in list" :key="index">
					<view class="uni-row Training-item">
						<view class="info">
							<text class="title">标题：{{item.title}}</text>
							<text class="synopsis">内容：{{item.content}}</text>
							<text class="synopsis">关联课程：{{item.courseTitle}}</text>
							<div class="uni-row">
								<text class="startTime">开始时间：{{item.startTime}}</text>
								<text class="endTime">结束时间：{{item.endTime}}</text>
							</div>
						</view>
					</view>
				</u-list-item>

				<!-- 加载状态提示 -->
				<u-loadmore :status="loadStatus" :loading-text="loadingText" :loadmore-text="loadmoreText"
					:nomore-text="nomoreText" />
			</u-list>
		</scroll-view>
	</view>
</template>

<script>
	import {
		getTrainingPlans
	} from '@/api/trainingPlan.js'

	export default {
		data() {
			return {
				user: [],
				list: [],         // 数据列表
				pageNum: 1,        // 当前页码
				pageSize: 10,      // 每页数量
				hasMore: true,     // 是否还有更多数据
				loading: false,    // 防止重复请求
				title: '',  // 搜索关键词
				token: '',
				loadStatus: 'loadmore',
				loadingText: '正在加载...',
				loadmoreText: '上拉加载更多',
				nomoreText: '没有更多了',
				popupVisible: false,
				loadingDetail: false,
				currentTraining: null
			}
		},
		onLoad() {
			this.user = JSON.parse(uni.getStorageSync('user'));
			this.token = this.user.token
			this.loadTrainingData()
		},

		methods: {
			// 时间格式化方法
			formatTime(timestamp) {
				return timestamp ? this.$u.timeFormat(timestamp, 'yyyy-mm-dd') : '未知时间'
			},

			// 加载课程数据
			async loadTrainingData() {
				if (this.loading || !this.hasMore) return;

				this.loading = true;
				this.loadStatus = 'loading';

				try {
					const res = await getTrainingPlans({
						pageNum: this.pageNum,
						pageSize: this.pageSize,
						title: this.title,
						token: this.token
					});
					const pageData = res.data || {};

					console
						.log('分页数据:', {
							list: pageData.list,
							pages: pageData.pages,
							total: pageData.total
						});

					const newList = pageData.list || [];
					const totalPages = pageData.pages || 0;

					// 数据合并逻辑
					if (this.pageNum === 1) {
						this.list = newList;
					} else {
						this.list = [...this.list, ...newList];
					}

					// 分页控制（根据pages字段）
					this.hasMore = this.pageNum < totalPages;
					this.loadStatus = this.hasMore ? 'loadmore' : 'nomore';

					// 仅在还有更多数据时递增页码
					if (this.hasMore && newList.length > 0) {
						this.pageNum++;
					}

				} catch (error) {
					console
						.error('请求失败:', error);
					uni
						.showToast({
							title: error.data?.msg || '加载失败',
							icon: 'none'
						});
					this.loadStatus = 'loadmore';
				} finally {
					this.loading = false;
				}
				console.log("title", this.title)
			},

			handleSearch() {
				// 重置时强制清空并重新加载
				this.pageNum = 1;
				this.hasMore = true;
				this.list = [];
				this.loadTrainingData();
				console.log("token", this.token)
			},

			// 加载更多
			loadMore() {
				if (this.hasMore && !this.loading) {
					this.loadTrainingData();
				}
			},

			// 下拉刷新
			onPullDownRefresh() {
				this.pageNum = 1;
				this.hasMore = true;
				this.title = ''; // 可选：是否清空搜索条件

				this.loadTrainingData().finally(() => {
					uni.stopPullDownRefresh();
				});
			}
		}
	}
</script>

<style>
	page {
		--primary-color: #2979ff;
		--success-color: #19be6b;
		--warning-color: #ff9900;
		--error-color: #fa3534;
		--info-color: #909399;
		--bg-color: #f8f9fa;
		--text-primary: #303133;
		--text-regular: #606266;
		--text-secondary: #909399;
		--border-color: #dcdfe6;
	}
</style>
