<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hanz.mapper.CourseMapper">
    <select id="selectAll" resultType="com.hanz.entity.Course">
        select * from `course`
                 <where>
                    <if test="title != null and title != ''">and title like concat('%',#{title},'%') </if>

                 </where>
                 order by id desc
    </select>

    <select id="selectById" resultType="com.hanz.entity.Course">
        select * from course where id = #{id}
    </select>


    <insert id="insert">
        insert into `course` (cover_url,title,synopsis,time,video_url)
        values (#{coverUrl}, #{title}, #{synopsis}, #{time},#{videoUrl})
    </insert>

    <update id="updateById">
        update `course` set cover_url = #{coverUrl},title = #{title},synopsis = #{synopsis},time = #{time},video_url = #{videoUrl}
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from `course` where id = #{id}
    </delete>
</mapper>
